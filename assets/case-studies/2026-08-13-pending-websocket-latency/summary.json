      },
      "boundary": "Completeness denominator contains only transactions with at least one Polygon OrderFilled log in the fully observed block interval."
    },
    {
      "claim": "Polynode pending beat Struct pending on every matched transaction in the explicit pending control.",
      "evidence": {
        "samples": 2486,
        "polynode_first": 2486,
        "polynode_first_pct": 100.0,
        "median_lead_ms": 22920.600916,
        "p75_lead_ms": 24573.7830185,
        "p95_lead_ms": 26938.98194125
      },
      "boundary": "Matched independently confirmed transaction hashes only; 106 Struct misses were reported as missing and did not become latency wins."
    },
    {
      "claim": "Polynode confirmation arrived before Struct pending on every matched transaction.",
      "evidence": {
        "samples": 2486,
        "polynode_status_update_first": 2486,
        "polynode_status_update_first_pct": 100.0,
        "median_lead_ms": 20306.647061,
        "p75_lead_ms": 21757.16062875,
        "p95_lead_ms": 25025.2802625
      },
      "boundary": "Polynode status_update is transaction confirmation; Struct was explicitly subscribed with status=pending."
    },
    {
      "claim": "Struct raw frames carried received_at values substantially earlier than subscriber arrival.",
      "evidence": {
        "raw_events": 9886,
        "median_reported_to_raw_callback_ms": 23675,
        "p75_reported_to_raw_callback_ms": 25856,
        "p95_reported_to_raw_callback_ms": 28613
      },
      "boundary": "Separate payload audit only. Competitive latency claims use local monotonic arrival timestamps and do not use provider timestamps."
    }
  ],
